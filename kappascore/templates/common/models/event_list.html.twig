{% for event in events %}
    {% if with_status is not defined or with_status == event.es %}
        {% set score = event.esc|split(':') %}
        {% set home_win = score[0]|default(0)|number_format > score[1]|default(0)|number_format %}
        {% set away_win = score[1]|default(0)|number_format > score[0]|default(0)|number_format %}
        <a href="/{{ lang }}/event/{{ event._id }}" class="event-on-list-details">
            <div class="event-on-list">
                <div class="event-on-list-col">
                    {{ jsDate("d/m/Y_H:i", event.ste)|replace({'_': '<br />'})|raw }}
                </div>
                <div class="event-on-list-col">
                    <div class="event-on-list-team">
                        <span class="event-on-list-team-name{% if event.es == 2 and home_win %} team-winner{% endif %}">{{ event.th.name }}</span>
                        {% if event.es != 0 %}<span class="event-on-list-team-score{% if event.es == 2 and home_win %} score-winner{% endif %}">{{ score[0] }}</span>{% endif %}
                    </div>
                    <div class="event-on-list-team">
                        <span class="event-on-list-team-name{% if event.es == 2 and away_win %} team-winner{% endif %}">{{ event.ta.name }}</span>
                        {% if event.es != 0 %}<span class="event-on-list-team-score{% if event.es == 2 and away_win %} score-winner{% endif %}">{{ score[1] }}</span>{% endif %}
                    </div>
                </div>
                <div class="event-on-list-col">
                    <i class="fa fa-info-circle" aria-hidden="true"></i>
                </div>
            </div>
        </a>
    {% endif %}
{% endfor %}