{% extends TemplatePath(template, "base.html.twig") %}

{% block pagetitle %}{% if sport_selected is not null %}{{ sport_selected.name }}{% else %}{{ Translate('Sport details') }}{% endif %}{% endblock %}

{% block header %}
    {% include TemplatePath(template, "parts/header.html.twig") %}
{% endblock %}

{% block content %}
    <style>
        .sport-page-wrapper {
            background: var(--secundary-bg-color);
            border-radius: var(--ks-radius-sm);
            overflow: hidden;
        }
        .search_box_sport {
            position: sticky;
            top: 0;
            z-index: 10;
            background: var(--secundary-bg-color);
            padding: 20px 15px 14px;
            border-bottom: 1px solid var(--ks-border);
        }
        .search_box_sport .search-inner {
            position: relative;
        }
        .search_box_sport i {
            position: absolute;
            top: 11px;
            left: 14px;
            color: var(--ks-text-secondary);
            font-size: 13px;
        }
        .search_box_sport input {
            border: 1px solid var(--ks-border);
            background: var(--third-bg-color);
            height: 40px;
            width: 100%;
            padding-left: 40px;
            color: var(--primary-font-color);
            border-radius: var(--ks-radius-sm);
            font-size: 13px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .search_box_sport input:focus {
            outline: none;
            border-color: var(--ks-accent);
            box-shadow: 0 0 0 2px rgba(76, 175, 80, 0.15);
        }
        .search_box_sport input::placeholder {
            color: var(--ks-text-dim);
        }

        div#content_sport {
            padding: 12px 15px 20px;
            max-height: calc(70vh - 74px);
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,0.15) transparent;
        }
        div#content_sport::-webkit-scrollbar {
            width: 5px;
        }
        div#content_sport::-webkit-scrollbar-track {
            background: transparent;
        }
        div#content_sport::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.15);
            border-radius: 4px;
        }

        .category_item a {
            padding: 14px 18px 14px 48px;
            background: var(--third-bg-color);
            color: var(--primary-font-color);
            display: flex;
            align-items: center;
            font-weight: 600;
            font-size: 13px;
            text-decoration: none;
            margin-bottom: 6px;
            position: relative;
            border: 1px solid var(--ks-border);
            border-radius: var(--ks-radius-sm);
            transition: all 0.15s ease;
        }
        .category_item a:hover {
            background: var(--ks-surface-hover);
            border-color: var(--ks-border-hover);
            color: #fff;
            transform: translateX(2px);
        }
        .category_item a:active {
            transform: translateX(0);
        }
        .category_item:last-child a {
            margin-bottom: 0;
        }
        .category_item a img {
            height: 16px;
            width: 22px;
            object-fit: cover;
            border-radius: 2px;
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            left: 16px;
        }
        .category_item a i {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--ks-text-dim);
            transition: color 0.15s ease, transform 0.15s ease;
        }
        .category_item a:hover i {
            color: var(--ks-accent);
            transform: translateY(-50%) translateX(2px);
        }
    </style>

    <div class="main-container">
        <div class="sport-page-wrapper">
            <div class="search_box_sport">
                <div class="search-inner">
                    <i class="fa fa-search" aria-hidden="true"></i>
                    <input type="text" placeholder="{{ Translate('Search country') }}" />
                </div>
            </div>
            <div id="content_sport">
                {% for category in categories|sort((a, b) => a.name > b.name) %}
                    <div class="category_item" data-cn="{{ category.name }}">
                        <a href="/{{ lang }}/sport/{{ sport_selected._id }}/{{ category._id }}">
                            <img class="flagicon" src="{{ ExternalCustomPath('media/images/flags/4x3/') ~ countyToCode(category.name) }}.svg" alt="{{ category.name }}">
                            {{ category.name }}
                            <i class="fa fa-angle-right" aria-hidden="true"></i>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{% block footer %}
    {% include TemplatePath(template, "parts/footer.html.twig") %}
{% endblock %}

{% block scripts %}

    {% include TemplatePath(template, "scripts/shared.html.twig") %}

    <script>

      async function initPage(){

        $(document).off('keyup', '.search_box_sport input');
        $(document).on('keyup', '.search_box_sport input', function(e){
          e.preventDefault();
          let el = $('#content_sport .category_item');
          let vu = $(this).val();
          if(vu.length > 0){
            el.each(function(){
              if($(this).data('cn').toLowerCase().indexOf(vu.toLowerCase()) !== -1){
                $(this).show();
              }else{
                $(this).hide();
              }
            });
          }else{
            el.show();
          }
        });

      }

      initPage();

    </script>

{% endblock %}