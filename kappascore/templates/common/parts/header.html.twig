<style>
    .ks-unified-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--ks-border);
        overflow: visible;
        width: 100%;
    }

    .ks-unified-header .main-container {
        overflow: visible;
        display: flex;
        align-items: center;
        height: 50px;
        gap: 24px;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        box-sizing: border-box;
    }

    /* Logo */
    .ks-unified-header .ks-logo {
        flex-shrink: 0;
    }
    .ks-unified-header .ks-logo a {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 22px;
        text-decoration: none;
        color: #fff;
        font-weight: 800;
        letter-spacing: -0.5px;
        white-space: nowrap;
    }
    .ks-unified-header .ks-logo a span {
        color: var(--ks-accent);
        font-weight: 800;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    /* Top links (Sports / Games / Top Lists) - desktop */
    .ks-unified-header .ks-toplinks {
        display: flex;
        align-items: center;
        gap: 2px;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-shrink: 0;
    }
    .ks-unified-header .ks-toplinks li a {
        font-size: 11px;
        text-transform: uppercase;
        text-decoration: none;
        color: #888888;
        font-weight: 600;
        letter-spacing: 0.8px;
        padding: 6px 12px;
        border-radius: 6px;
        transition: all 0.12s ease;
        white-space: nowrap;
    }
    .ks-unified-header .ks-toplinks li a:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.06);
    }
    .ks-unified-header .ks-toplinks li a.active {
        color: #000;
        background: #22c55e;
        border-radius: 999px;
        font-weight: 700;
    }

    /* Nav pills (Results / Statistics / Live Score) - desktop */
    .ks-unified-header .ks-nav {
        display: flex;
        align-items: center;
        gap: 2px;
        margin-left: auto;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--ks-border);
        border-radius: 10px;
        padding: 3px;
        flex-shrink: 0;
    }
    .ks-unified-header .ks-nav a {
        text-decoration: none;
        color: var(--ks-text-secondary);
        font-size: 12.5px;
        font-weight: 600;
        padding: 7px 16px;
        border-radius: 7px;
        transition: all var(--ks-transition);
        display: inline-flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }
    .ks-unified-header .ks-nav a:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.06);
    }
    .ks-unified-header .ks-nav a.active {
        color: #fff;
        background: #22c55e;
        box-shadow: 0 2px 12px rgba(34, 197, 94, 0.4);
    }
    .ks-unified-header .ks-nav a.active:hover {
        background: #16a34a;
        color: #fff;
    }
    .ks-unified-header .ks-nav a i {
        font-size: 12px;
    }

    /* Lang selector */
    .ks-unified-header .lang-selector {
        position: relative;
        flex-shrink: 0;
    }
    .ks-unified-header .lang-selected {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        background: rgba(34, 197, 94, 0.1);
        color: #22c55e;
        border: 1px solid #22c55e;
        border-radius: 8px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        transition: all 0.2s ease;
        white-space: nowrap;
        max-width: 90px;
        box-sizing: border-box;
    }
    .ks-unified-header .lang-selected:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.15);
    }
    .ks-unified-header .lang-selected .fi {
        width: 20px;
        height: 15px;
        flex-shrink: 0;
    }
    .ks-unified-header .lang-selected .lang-label {
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .ks-unified-header .lang-dropdown {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        background: #1a1a1a;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        list-style: none;
        padding: 6px;
        margin: 0;
        display: none;
        z-index: 9999;
        min-width: 140px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
    }
    .ks-unified-header .lang-dropdown li {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        cursor: pointer;
        color: #ccc;
        font-size: 13px;
        font-weight: 500;
        border-radius: 8px;
        transition: all 0.12s ease;
    }
    .ks-unified-header .lang-dropdown li:hover {
        background: rgba(34, 197, 94, 0.1);
        color: #22c55e;
    }
    .ks-unified-header .lang-dropdown .fi {
        width: 20px;
        height: 15px;
        flex-shrink: 0;
    }
    .ks-unified-header .lang-selector:hover .lang-dropdown,
    .ks-unified-header .lang-dropdown.open {
        display: block;
    }

    /* Bottom nav bar - mobile only */
    .ks-bottom-nav {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 9999;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 6px 8px calc(6px + env(safe-area-inset-bottom, 0px)) 8px;
        width: 100%;
        box-sizing: border-box;
    }
    .ks-bottom-nav__inner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        max-width: 400px;
        margin: 0 auto;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 14px;
        padding: 4px;
    }
    .ks-bottom-nav a {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none;
        color: #777;
        font-size: 11.5px;
        font-weight: 600;
        padding: 10px 6px;
        border-radius: 10px;
        transition: all 0.2s ease;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
    }
    .ks-bottom-nav a:hover {
        color: #ccc;
    }
    .ks-bottom-nav a.active {
        color: #fff;
        background: #22c55e;
        box-shadow: 0 2px 12px rgba(34, 197, 94, 0.4);
    }
    .ks-bottom-nav a i {
        font-size: 13px;
        flex-shrink: 0;
    }

    /* Tablet */
    @media only screen and (max-width: 1024px) {
        .ks-unified-header .main-container {
            gap: 12px;
            padding: 0 16px;
        }
        .ks-unified-header .ks-nav a {
            font-size: 11.5px;
            padding: 6px 10px;
            gap: 5px;
        }
        .ks-unified-header .ks-toplinks li a {
            font-size: 10px;
            padding: 5px 8px;
        }
    }

    /* Mobile */
    @media only screen and (max-width: 768px) {
        .ks-unified-header {
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .ks-unified-header .ks-toplinks {
            display: none;
        }
        .ks-unified-header .ks-nav {
            display: none;
        }
        .ks-unified-header .main-container {
            height: 50px;
            min-height: 50px;
            padding: 0 12px;
            gap: 8px;
        }
        .ks-unified-header .ks-logo a {
            font-size: 20px;
        }
        .ks-unified-header .lang-selector {
            margin-left: auto;
        }
        .ks-unified-header .lang-selected {
            padding: 5px 10px;
            font-size: 11px;
            gap: 6px;
            max-width: 80px;
        }
        .ks-unified-header .lang-selected .fi {
            width: 18px;
            height: 13px;
        }

        .ks-bottom-nav {
            display: block;
        }
        body {
            padding-bottom: 64px;
        }

        /* Bottom nav responsive text */
        .ks-bottom-nav a {
            font-size: 10.5px;
            padding: 9px 4px;
            gap: 4px;
        }
        .ks-bottom-nav a i {
            font-size: 12px;
        }
    }

    /* Small mobile */
    @media only screen and (max-width: 480px) {
        .ks-unified-header .main-container {
            padding: 0 10px;
        }
        .ks-unified-header .ks-logo a {
            font-size: 18px;
        }
        .ks-unified-header .lang-selected {
            padding: 4px 8px;
            font-size: 10px;
            max-width: 70px;
        }
        .ks-unified-header .lang-selected .fi {
            width: 16px;
            height: 12px;
        }

        .ks-bottom-nav a {
            font-size: 9.5px;
            padding: 8px 3px;
            gap: 3px;
        }
        .ks-bottom-nav a i {
            font-size: 11px;
        }
    }

    /* Ultra small */
    @media only screen and (max-width: 320px) {
        .ks-unified-header .ks-logo a {
            font-size: 16px;
        }
        .ks-unified-header .lang-selected {
            padding: 3px 6px;
            font-size: 9px;
            gap: 4px;
            max-width: 60px;
        }
        .ks-bottom-nav__inner {
            gap: 2px;
            padding: 3px;
            border-radius: 10px;
        }
        .ks-bottom-nav a {
            font-size: 8.5px;
            padding: 7px 2px;
            gap: 2px;
        }
        .ks-bottom-nav a i {
            font-size: 10px;
        }
    }

    /* Hide legacy elements */
    .ks-unified-header .ks-mobile-nav-container {
        display: none;
    }
</style>

<div id="preloader" style="display:none;">
    <div id="loader"></div>
</div>

<div class="ks-unified-header">
    <div class="main-container">
        <div class="ks-logo">
            <a href="/{{ lang }}">Kappa<span>score</span></a>
        </div>

        <ul class="ks-toplinks">
            <li><a class="active" href="https://kappascore.com">{{ Translate('Sports') }}</a></li>
            <li><a href="https://kappaslot.com">{{ Translate('Games') }}</a></li>
            <li><a href="https://kappatop.com">{{ Translate('Top Lists') }}</a></li>
        </ul>

        <nav class="ks-nav">
            <a href="/{{ lang }}" {% if isActiveMenu('/') %}class="active"{% endif %}><i class="fa fa-bars" aria-hidden="true"></i> {{ Translate('Results') }}</a>
            <a href="/{{ lang }}/statistics" {% if isActiveMenu('/statistics') %}class="active"{% endif %}><i class="fa fa-line-chart" aria-hidden="true"></i> {{ Translate('Statistics') }}</a>
            <a href="/{{ lang }}/live-score" {% if isActiveMenu('/live-score') %}class="active"{% endif %}><i class="fa fa-desktop" aria-hidden="true"></i> {{ Translate('Live Score') }}</a>
        </nav>

        <div class="lang-selector">
            <button class="lang-selected" type="button">
                <span class="fi fi-{{ lang }}"></span>
                <span class="lang-label">{{ lang|upper }}</span>
            </button>
            <ul class="lang-dropdown">
                {% for lg in langs|keys %}
                    <li data-lang="{{ lg }}" data-iso="{{ langs[lg] }}">
                        <span class="fi fi-{{ langs[lg]|replace({'en':'us'}) }}"></span>
                        <span>{{ langs[lg]|replace({'en':'us'})|upper }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>


<div class="ks-bottom-nav">
    <div class="ks-bottom-nav__inner">
        <a href="/{{ lang }}" {% if isActiveMenu('/') %}class="active"{% endif %}><i class="fa fa-bars" aria-hidden="true"></i> {{ Translate('Results') }}</a>
        <a href="/{{ lang }}/statistics" {% if isActiveMenu('/statistics') %}class="active"{% endif %}><i class="fa fa-line-chart" aria-hidden="true"></i> {{ Translate('Statistics') }}</a>
        <a href="/{{ lang }}/live-score" {% if isActiveMenu('/live-score') %}class="active"{% endif %}><i class="fa fa-desktop" aria-hidden="true"></i> {{ Translate('Live Score') }}</a>
    </div>
</div>

<script>
  function setCookie(name, value, days = 365, path = "/") {
    const expires = new Date(Date.now() + days * 24 * 60 * 60 * 1000).toUTCString();
    document.cookie = `${encodeURIComponent(name)}=${encodeURIComponent(value)}; expires=${expires}; path=${path}; SameSite=Lax`;
  }

  // Toggle language dropdown on click
  document.querySelector('.lang-selected').addEventListener('click', function(e) {
    e.stopPropagation();
    document.querySelector('.lang-dropdown').classList.toggle('open');
  });
  document.addEventListener('click', function() {
    document.querySelector('.lang-dropdown').classList.remove('open');
  });

  document.querySelectorAll('.lang-dropdown li').forEach(item => {
    item.addEventListener('click', () => {
      const iso = item.dataset.iso;
      const lang = item.dataset.lang;
      const selected = document.querySelector('.lang-selected');
      selected.innerHTML = `
        <span class="fi fi-${iso}"></span>
        <span class="lang-label">${iso.toUpperCase()}</span>
      `;
      setCookie('lang', lang, 365);
      const path = window.location.pathname;
      const newPath = path.replace(/^\/[a-z]{2}(?=\/|$)/i, `/${iso}`);
      window.location.href = newPath + window.location.search + window.location.hash;
    });
  });

  // Highlight active nav based on current URL
  (function() {
    var path = window.location.pathname.replace(/^\/[a-z]{2}/i, '') || '/';
    function getSection(p) {
      if (p.startsWith('/statistics')) return 'statistics';
      if (p.startsWith('/live-score')) return 'live-score';
      return 'results';
    }
    var currentSection = getSection(path);
    function setActive(selector) {
      document.querySelectorAll(selector + ' a').forEach(function(a) {
        var href = a.getAttribute('href') || '';
        if (href.startsWith('http')) return;
        var hrefPath = href.replace(/^\/[a-z]{2}/i, '') || '/';
        var linkSection = getSection(hrefPath);
        if (currentSection === linkSection) {
          a.classList.add('active');
        } else {
          a.classList.remove('active');
        }
      });
    }
    setActive('.ks-nav');
    setActive('.ks-bottom-nav__inner');
  })();
</script>
