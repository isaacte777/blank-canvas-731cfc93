{% extends TemplatePath(template, "base.html.twig") %}

{% block pagetitle %}{% if page_title is defined and page_title is not null %}{{ page_title }}{% else %}{{ Translate('Last results') }}{% endif %}{% endblock %}

{% block header %}
    {% include TemplatePath(template, "parts/header.html.twig") %}
    {% include TemplatePath(template, "parts/subheader.html.twig") with {'parent_page': '/' ~ lang} %}
{% endblock %}

{% block content %}
    <style>
        div#calendar {
            margin-top: 0;
            position: relative;
            background: var(--secundary-bg-color);
            color: var(--primary-font-color);
            padding: 10px;
        }
        .calendar .day {
            width: 16px!important;
            height: 16px!important;
            font-size: 14px!important;
            line-height: normal!important;
            cursor:pointer!important;
        }
        .calendar td {
            font-size: 14px!important;
        }
        .calendar .day.has-event:after {
            background: var(--nav-bg-color) !important;
            width: 14px !important;
            height: 2px !important;
            left: calc(50% - 6.5px)!important;
            border-radius: 0px !important;
        }
        .calendar table {
            margin: 0px!important;
        }

        /* Tab bar */
        .tabs-homepage-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
        }
        .tabs-homepage-bar .tabs-homepage-live {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            line-height: 26px;
            font-size: 12.5px;
            font-weight: 700;
            color: #000;
            text-decoration: none;
            padding: 7px 20px;
            border-radius: 7px;
            background: var(--ks-accent);
            box-shadow: 0 2px 12px rgba(34, 197, 94, 0.4);
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .tabs-homepage-bar .tabs-homepage-live:hover {
            background: var(--ks-accent-soft);
        }
        .tabs-homepage-bar .tabs-homepage-live.tabs-homepage-live--active {
            box-shadow: 0 2px 18px rgba(34, 197, 94, 0.6);
            outline: 2px solid rgba(34, 197, 94, 0.5);
            outline-offset: 2px;
        }
        .live-lbl {
            position: relative;
            color: #22c55e;
            font-weight: 700;
        }
        .live-lbl::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -3px;
            height: 2px;
            width: 100%;
            background: linear-gradient(90deg, transparent, #00ff5a, transparent);
            background-size: 200% 100%;
            animation: liveBarMove 2s linear infinite;
        }
        @keyframes liveBarMove {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        .tabs-homepage-bar .tabs-homepage-live .live-dot {
            width: 6px;
            height: 6px;
            background: #000;
            border-radius: 50%;
            animation: livePulse 1.5s infinite;
        }
        @keyframes livePulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }
        .tabs-homepage-bar .tabs-homepage-live .live-count {
            background: rgba(0,0,0,0.2);
            padding: 1px 7px;
            border-radius: 999px;
            font-size: 10px;
            margin-left: 4px;
        }

        /* Filter icon button */
        .tabs-homepage-bar .tabs-filter-icon-wrapper {
            position: relative;
            margin-left: auto;
        }
        .tabs-homepage-bar .tabs-filter-icon-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            line-height: 26px;
            font-size: 12px;
            font-weight: 600;
            color: var(--ks-text-secondary);
            background: var(--third-bg-color);
            border: 1px solid var(--ks-border);
            padding: 7px 14px;
            border-radius: 7px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
        }
        .tabs-homepage-bar .tabs-filter-icon-btn:hover,
        .tabs-homepage-bar .tabs-filter-icon-btn.open {
            color: #fff;
            background: rgba(255, 255, 255, 0.06);
            border-color: var(--ks-border-hover);
        }
        .tabs-homepage-bar .tabs-filter-icon-btn .filter-active-dot {
            width: 5px;
            height: 5px;
            background: var(--ks-accent);
            border-radius: 50%;
            display: none;
        }
        .tabs-homepage-bar .tabs-filter-icon-btn .filter-active-dot.visible {
            display: inline-block;
        }

        /* Filter dropdown */
        .tabs-filter-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 6px);
            right: 0;
            background: var(--third-bg-color);
            border: 1px solid var(--ks-border);
            border-radius: 10px;
            padding: 4px;
            z-index: 50;
            min-width: 170px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
        }
        .tabs-filter-dropdown.open {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .tabs-filter-dropdown a {
            display: flex;
            align-items: center;
            gap: 8px;
            line-height: 26px;
            font-size: 12px;
            font-weight: 600;
            color: var(--ks-text-secondary);
            border: none;
            text-decoration: none;
            padding: 7px 14px;
            border-radius: 7px;
            transition: all 0.2s ease;
            cursor: pointer;
            white-space: nowrap;
        }
        .tabs-filter-dropdown a:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.06);
        }
        .tabs-filter-dropdown a.active {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            font-weight: 700;
        }

        /* Favorite star */
        .fav-star-btn {
            cursor: pointer;
            transition: color 0.15s ease;
        }
        .fav-star-btn:hover {
            color: #facc15 !important;
        }
        .fav-star-btn.is-fav i {
            color: #facc15;
        }
        .fav-star-btn.is-fav i::before {
            content: "\f005";
        }
        .fav-count-badge {
            background: rgba(250, 204, 21, 0.2);
            color: #facc15;
            font-size: 9px;
            padding: 1px 6px;
            border-radius: 999px;
            margin-left: auto;
            font-weight: 700;
        }

        .tabs-homepage-filters {
            display: inline-flex;
            vertical-align: top;
            gap: 4px;
            flex-wrap: wrap;
        }
        .tabs-homepage-filters a {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            line-height: 26px;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--ks-text-secondary);
            border: none;
            text-decoration: none;
            padding: 7px 20px;
            border-radius: 7px;
            transition: all 0.2s ease;
            background: var(--third-bg-color);
            border: 1px solid var(--ks-border);
        }
        .tabs-homepage-filters a:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.06);
        }
        .tabs-homepage-filters a.active {
            background: var(--ks-accent);
            color: #000;
            font-weight: 700;
            box-shadow: 0 2px 12px rgba(34, 197, 94, 0.4);
        }
        .tabs-homepage-filters a.active:hover {
            background: var(--ks-accent-soft);
            color: #000;
        }
        .tabs-homepage-filters a img {
            height: 12px;
            vertical-align: initial;
        }

        #all-events {
            max-height: 520px;
            overflow: hidden;
            position: relative;
        }
        #all-events-inner {
            max-height: 520px;
            overflow-y: scroll;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        #all-events-inner::-webkit-scrollbar {
            display: none;
        }

        /* Custom scrollbar track + thumb */
        .ks-custom-scrollbar {
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 10px;
            background: rgba(255, 255, 255, 0.04);
            border-radius: 8px;
            z-index: 10;
            cursor: pointer;
        }
        .ks-custom-scrollbar__thumb {
            position: absolute;
            top: 0;
            right: 0;
            width: 10px;
            min-height: 50px;
            background: var(--ks-accent);
            border-radius: 8px;
            cursor: grab;
            transition: background 0.15s ease, box-shadow 0.15s ease;
            box-shadow: 0 0 8px rgba(34, 197, 94, 0.3);
        }
        .ks-custom-scrollbar__thumb:hover,
        .ks-custom-scrollbar__thumb.dragging {
            background: var(--ks-accent-soft);
            box-shadow: 0 0 14px rgba(34, 197, 94, 0.5);
            cursor: grabbing;
        }

        .league_line_items {
            margin-bottom: 12px;
            border-radius: var(--ks-radius);
            overflow: hidden;
            border: 1px solid var(--ks-border);
            background: var(--third-bg-color);
            transition: border-color 0.2s ease;
        }
        .league_line_items:hover {
            border-color: var(--ks-border-hover);
        }
        .league_line_items_header {
            background: rgba(34, 197, 94, 0.08);
            color: #fff;
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            line-height: 36px;
            position: relative;
            padding: 0 16px;
            border-bottom: 1px solid var(--ks-border);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .league_line_items_header img.flagicon {
            height: 14px;
            flex-shrink: 0;
        }
        .league_line_items_events > a {
            text-decoration: none;
        }
        .league_line_items_events .league_line_items_event {
            background: var(--third-bg-color);
            white-space: nowrap;
            padding: 5px 0;
            color: var(--primary-font-color);
            height: auto;
            min-height: 38px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            transition: background 0.12s ease;
            display: flex;
            align-items: center;
        }
        .league_line_items_events .league_line_items_event:last-child {
            border-bottom: none;
        }
        .league_line_items_events .league_line_items_event:hover {
            background: rgba(34, 197, 94, 0.04);
        }
        .league_line_items_events .league_line_items_event > div {
            display: inline-block;
            vertical-align: top;
            align-items: center;
            align-content: center;
            height: 100%;
        }
        .league_line_items_events .league_line_items_event > .league_line_items_event_opt {
            width: 40px;
            text-align: center;
            color: var(--ks-text-dim);
        }
        .league_line_items_events .league_line_items_event > .league_line_items_event_time {
            width: 80px;
            text-align: center;
            font-size: 12px;
            white-space: normal;
            color: var(--ks-text-secondary);
        }
        .league_line_items_events .league_line_items_event > div.league_line_items_event_name {
            width: calc(100% - 40px - 80px - 50px - 70px);
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
            text-overflow: ellipsis;
            overflow: hidden;
        }
        .league_line_items_events .league_line_items_event > div.league_line_items_event_score {
            width: 50px;
            font-size: 13px;
            font-weight: 700;
            text-align: center;
            color: #fff;
        }
        .league_line_items_events .league_line_items_event > div.league_line_items_event_btn {
            width: 53px;
        }
        .league_line_items_events .league_line_items_event > div.league_line_items_event_name a {
            color: var(--primary-font-color);
            text-decoration: none;
            width: 100%;
            display: inline-block;
            transition: color 0.12s ease;
        }
        .league_line_items_events .league_line_items_event:hover > div.league_line_items_event_name a {
            color: #fff;
        }
        .league_line_items_events .league_line_items_event > div.league_line_items_event_btn a {
            color: var(--ks-text-dim);
            transition: color 0.12s ease;
        }
        .league_line_items_events .league_line_items_event:hover > div.league_line_items_event_btn a {
            color: var(--ks-accent);
        }

        /* Event type badge */
        .event-type-badge {
            display: inline-block;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            padding: 1px 5px;
            border-radius: 3px;
            letter-spacing: 0.5px;
        }
        .event-type-badge--finished {
            background: rgba(255,255,255,0.08);
            color: var(--ks-text-secondary);
        }
        .event-type-badge--upcoming {
            background: rgba(34, 197, 94, 0.1);
            color: var(--ks-accent);
        }

        h2 {
            color: var(--ks-accent);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--ks-border);
            width: 100%;
        }

        .hp-contents {
            white-space: nowrap;
            min-height: 600px;
            padding: 24px 0 48px;
            display: flex;
            align-items: flex-start;
            width: 100%;
            box-sizing: border-box;
        }
        .right-container {
            width: calc(100% - 260px);
            display: flex;
            flex-direction: column;
            vertical-align: top;
            padding-left: 24px;
        }
        .left-bar-container {
            width: 240px;
            min-width: 240px;
            display: flex;
            flex-direction: column;
            vertical-align: top;
            gap: 12px;
        }
        .left-bar-section {
            background: var(--third-bg-color);
            border: 1px solid var(--ks-border);
            border-radius: var(--ks-radius);
            padding: 14px;
        }

        ul.list-left-bar-hp {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        ul.list-left-bar-hp li {
            margin-bottom: 1px;
            padding: 0;
        }
        ul.list-left-bar-hp li a i {
            position: absolute;
            right: 10px;
            top: 3px;
            background: transparent;
            display: none;
            color: var(--ks-accent);
        }
        ul.list-left-bar-hp li.selected a i {
            display: block;
        }
        ul.list-left-bar-hp li a {
            position: relative;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--ks-text-secondary);
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 500;
            width: 100%;
            padding: 8px 10px;
            border-radius: 6px;
            transition: all 0.12s ease;
        }
        ul.list-left-bar-hp li a:hover {
            background: var(--ks-accent-glow);
            color: var(--ks-accent);
        }
        ul.list-left-bar-hp li img {
            height: 14px;
            position: static;
            flex-shrink: 0;
        }

        .list-left-bar-hp-countries {
            max-height: 280px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,0.15) transparent;
        }
        .list-left-bar-hp-countries::-webkit-scrollbar {
            width: 5px;
        }
        .list-left-bar-hp-countries::-webkit-scrollbar-track {
            background: transparent;
        }
        .list-left-bar-hp-countries::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.15);
            border-radius: 4px;
        }
        .list-left-bar-hp-countries::-webkit-scrollbar-thumb:hover {
            background: rgba(255,255,255,0.25);
        }
        @media only screen and (max-width: 768px) {
            .left-bar-container {
                display: none!important;
            }
            .right-container {
                width: 100%;
                padding-left: 0;
            }
            .hp-contents {
                padding: 16px 0 32px;
            }
            .main-container {
                padding: 0 12px;
                max-width: 100%;
            }

            /* Live button + filter group on same row */
            .tabs-homepage-bar {
                flex-wrap: nowrap;
                gap: 8px;
                margin: 0 0 12px;
                align-items: center;
            }
            .tabs-homepage-bar .tabs-homepage-live {
                font-size: 11px;
                padding: 6px 12px;
                flex-shrink: 0;
            }
            .tabs-homepage-bar .tabs-homepage-live .live-count {
                font-size: 9px;
                padding: 1px 5px;
            }
            .tabs-filter-icon-btn {
                font-size: 10.5px !important;
                padding: 5px 10px !important;
            }
            .tabs-filter-dropdown {
                min-width: 150px;
            }

            /* Sports filters full width */
            .tabs-homepage-filters {
                margin: 0;
                width: 100%;
                justify-content: center;
            }
            .tabs-homepage-filters a {
                flex: 1;
                justify-content: center;
                text-align: center;
                font-size: 11px;
                padding: 6px 10px;
            }
            .league_line_items_header {
                font-size: 10.5px;
                padding: 0 12px;
                line-height: 32px;
            }
            .league_line_items_events .league_line_items_event > div.league_line_items_event_name {
                font-size: 12px;
            }
        }
    </style>
    <div class="main-container">

        <div class="hp-contents">

            <div class="left-bar-container">

                {% set fixed_leagues = 0 %}

                {% for sport in sport_menu %}
                    {% if sport._id == sport_selected %}
                        {% for tournament in sport.tournaments %}
                            {% set fixed_leagues = fixed_leagues+1 %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}

                {% if fixed_leagues > 0 %}
                <div class="left-bar-section">
                    <h2><i class="fa fa-thumb-tack" aria-hidden="true"></i> {{ Translate('Fixed leagues') }}</h2>

                    <ul class="list-left-bar-hp">
                        {% for sport in sport_menu %}
                            {% if sport._id == sport_selected %}

                                {% for tournament in sport.tournaments %}
                                    <li><a href="/{{ lang }}/tournament/{{ tournament._id }}" data-cid="{{ tournament.oxb_id }}" data-type="tournament">{{ countryToFlag(tournament.category.name) }} {{ tournament.name }}</a></li>
                                {% endfor %}

                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}

                <div class="left-bar-section">
                    <h2>{{ Translate('Countries') }}</h2>

                    <ul class="list-left-bar-hp list-left-bar-hp-countries">
                        {% set unique_countries = [] %}
                        {% set total_countries = 0 %}
                        {% for result in next_events %}
                            {% if result.country not in unique_countries %}
                                {% set unique_countries = unique_countries|merge([result.country]) %}
                                <li class="filter-by-country-btn" data-cid="{{ result.country_id }}" data-country-code="{{ countyToCode(result.country) }}" data-cn="{{ result.country }}">
                                    <a href="#" data-type="tournament">
                                        {{ countryToFlag(result.country) }}
                                        {{ result.country }}
                                        <i class="fa fa-window-close-o" aria-hidden="true"></i>
                                    </a>
                                </li>
                                {% set total_countries = total_countries+1 %}
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>

                <div class="ks-ad-wrapper" id="ks-ad-leftbar">
                    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2502506691273037"
                            crossorigin="anonymous"></script>
                    <!-- Leftbar Bottom -->
                    <ins class="adsbygoogle"
                         style="display:block"
                         data-ad-client="ca-pub-2502506691273037"
                         data-ad-slot="3132804372"
                         data-ad-format="auto"
                         data-full-width-responsive="true"></ins>
                    <script>
                      (adsbygoogle = window.adsbygoogle || []).push({});
                    </script>
                </div>

            </div>

            <div class="right-container">

                <div class="ks-ad-wrapper" id="ks-ad-top">
                    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2502506691273037"
                            crossorigin="anonymous"></script>
                    <!-- Banner Top Side -->
                    <ins class="adsbygoogle"
                         style="display:block"
                         data-ad-client="ca-pub-2502506691273037"
                         data-ad-slot="7159679298"
                         data-ad-format="auto"
                         data-full-width-responsive="true"></ins>
                    <script>
                      (adsbygoogle = window.adsbygoogle || []).push({});
                    </script>
                </div>

                {% if favorite_events|length > 0 %}

                    <h2>{{ Translate('Recommended Events') }}</h2>

                    {% for result in favorite_events %}
                        <div class="league_line_items">
                            <div class="league_line_items_header">
                                {{ countryToFlag(result.country) }}
                                {{ result.country|upper }}: {{ result.name }} <i class="fa fa-thumb-tack" aria-hidden="true"></i>
                            </div>
                            <div class="league_line_items_events">
                                {% for event in result.events %}
                                    <div class="league_line_items_event">
                                        <div class="league_line_items_event_opt"><i class="fa fa-star-o" aria-hidden="true"></i></div>
                                        <div class="league_line_items_event_time">{{ jsDate("d/m/Y H:i", event.ste) }}</div>
                                        <div class="league_line_items_event_name"><a href="/{{ lang }}/event/{{ event.int_id }}">{{ event.en|replace({' - ': "<br />"})|raw }}</a></div>
                                        <div class="league_line_items_event_score"></div>
                                        <div class="league_line_items_event_btn">
                                            <a href="#results" class="active" title="{{ Translate('View details') }}"><i class="fa fa-desktop" aria-hidden="true"></i></a>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}

                {% endif %}

                
                <div class="tabs-homepage-bar">
                    <button type="button" class="tabs-homepage-live" id="live-events-btn">
                        <span class="live-dot"></span>
                        {{ Translate('Live') }}
                        <span class="live-count">0</span>
                    </button>

                    <div class="tabs-filter-icon-wrapper">
                        <button type="button" class="tabs-filter-icon-btn" id="filter-toggle-btn">
                            <i class="fa fa-filter"></i> {{ Translate('Filter') }}
                            <span class="filter-active-dot" id="filter-active-dot"></span>
                        </button>
                        <div class="tabs-filter-dropdown" id="filter-dropdown">
                            <a href="#" class="filter-type-btn active" data-filter="all">
                                <i class="fa fa-list"></i> {{ Translate('All') }}
                            </a>
                            <a href="#" class="filter-type-btn" data-filter="results">
                                <i class="fa fa-check-circle"></i> {{ Translate('Results') }}
                            </a>
                            <a href="#" class="filter-type-btn" data-filter="next">
                                <i class="fa fa-clock-o"></i> {{ Translate('Next events') }}
                            </a>
                            <a href="#" class="filter-type-btn" data-filter="favorites">
                                <i class="fa fa-star"></i> {{ Translate('Favorites') }}
                                <span class="fav-count-badge" id="fav-count-badge">0</span>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="tabs-homepage-filters"></div>

                
                <div id="all-events">
                    <div id="all-events-inner">
                    {# All events unified in a single list with data-ste for date sorting ASC #}
                    {% for result in last_results %}
                        <div class="league_line_items" data-cid="{{ result.country_id }}" data-event-type="results" data-ste="{{ result.events[0].ste|default(0) }}">
                            <div class="league_line_items_header">
                                {{ countryToFlag(result.country) }}
                                {{ result.country|upper }}: {{ result.name }}
                            </div>
                            <div class="league_line_items_events">
                                {% for event in result.events %}
                                    <div class="league_line_items_event" data-event-id="{{ event._id|default(event.int_id) }}" data-event-alt-id="{{ event.int_id|default(event._id) }}">
                                        <div class="league_line_items_event_opt fav-star-btn" data-eid="{{ event._id|default(event.int_id) }}" data-eid-alt="{{ event.int_id|default(event._id) }}"><i class="fa fa-star-o" aria-hidden="true"></i></div>
                                        <div class="league_line_items_event_time">
                                            <span class="event-type-badge event-type-badge--finished">FT</span>
                                        </div>
                                        <div class="league_line_items_event_name"><a href="/{{ lang }}/event/{{ event.int_id }}">{{ event.en|replace({' - ': "<br />"})|raw }}</a></div>
                                        <div class="league_line_items_event_score">{{ event.esc|replace({':': "<br />"})|raw }}</div>
                                        <div class="league_line_items_event_btn">
                                            <a href="/{{ lang }}/event/{{ event.int_id }}" title="{{ Translate('View details') }}"><i class="fa fa-info-circle" aria-hidden="true"></i></a>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}

                    {% for result in next_events %}
                        <div class="league_line_items" data-cid="{{ result.country_id }}" data-event-type="next" data-ste="{{ result.events[0].ste|default(0) }}">
                            <div class="league_line_items_header">
                                {{ countryToFlag(result.country) }}
                                {{ result.country|upper }}: {{ result.name }}
                            </div>
                            <div class="league_line_items_events">
                                {% for event in result.events %}
                                    <div class="league_line_items_event" data-event-id="{{ event._id|default(event.int_id) }}" data-event-alt-id="{{ event.int_id|default(event._id) }}">
                                        <div class="league_line_items_event_opt fav-star-btn" data-eid="{{ event._id|default(event.int_id) }}" data-eid-alt="{{ event.int_id|default(event._id) }}"><i class="fa fa-star-o" aria-hidden="true"></i></div>
                                        <div class="league_line_items_event_time">{{ jsDate("d/m/Y H:i", event.ste) }}</div>
                                        <div class="league_line_items_event_name"><a href="/{{ lang }}/event/{{ event.int_id }}">{{ event.en|replace({' - ': "<br />"})|raw }}</a></div>
                                        <div class="league_line_items_event_score"></div>
                                        <div class="league_line_items_event_btn">
                                            <a href="/{{ lang }}/event/{{ event.int_id }}" title="{{ Translate('View details') }}"><i class="fa fa-desktop" aria-hidden="true"></i></a>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                    </div>
                    <div class="ks-custom-scrollbar" id="ks-scrollbar-track">
                        <div class="ks-custom-scrollbar__thumb" id="ks-scrollbar-thumb"></div>
                    </div>
                </div>

            </div>
        </div>

    </div>
{% endblock %}

{% block footer %}
    {% include TemplatePath(template, "parts/footer.html.twig") %}
{% endblock %}

{% block scripts %}

    {% include TemplatePath(template, "scripts/shared.html.twig") %}

    <script>

      let countries_selected = [];
      let currentFilter = 'all';
      let timerLiveCounter;
      let isLiveMode = false;
      let liveRefreshTimer = null;
      let filterDropdownOpen = false;

      // Store original content for restoring when exiting live mode
      let originalEventsHTML = null;
      let originalCountriesHTML = null;
      // Store last live events HTML so favorited live events persist across tabs
      let lastLiveEventsHTML = null;

      // ─── Favorites (localStorage) ───
      function getFavorites(){
        try { return JSON.parse(localStorage.getItem('ks_fav_events') || '[]'); }
        catch(e){ return []; }
      }
      function saveFavorites(favs){
        localStorage.setItem('ks_fav_events', JSON.stringify(favs));
      }
      function isFavorite(eid){
        return getFavorites().indexOf(String(eid)) !== -1;
      }
      function toggleFavorite(eid, altEid){
        eid = String(eid || '');
        altEid = String(altEid || '');
        let favs = getFavorites();
        let exists = (eid && favs.indexOf(eid) !== -1) || (altEid && favs.indexOf(altEid) !== -1);

        if(!exists){
          if(eid && favs.indexOf(eid) === -1) favs.push(eid);
          if(altEid && altEid !== eid && favs.indexOf(altEid) === -1) favs.push(altEid);
        } else {
          favs = favs.filter(function(id){
            return id !== eid && id !== altEid;
          });
        }
        saveFavorites(favs);
        refreshFavStars();
        updateFavCount();
        if(currentFilter === 'favorites') applyFilters();
      }
      function refreshFavStars(){
        let favs = getFavorites();
        $('.fav-star-btn').each(function(){
          let eid = String($(this).data('eid') || '');
          let altEid = String($(this).data('eid-alt') || '');
          if((eid && favs.indexOf(eid) !== -1) || (altEid && favs.indexOf(altEid) !== -1)){
            $(this).addClass('is-fav');
          } else {
            $(this).removeClass('is-fav');
          }
        });
      }
      function updateFavCount(){
        let count = getFavorites().length;
        $('#fav-count-badge').text(count);
      }

      // ─── Country name → ISO code mapping for JS-generated flags ───
      var countryCodeMap = {
        'spain':'es','england':'gb-eng','germany':'de','italy':'it','france':'fr',
        'portugal':'pt','netherlands':'nl','brazil':'br','argentina':'ar','turkey':'tr',
        'belgium':'be','scotland':'gb-sct','greece':'gr','austria':'at','switzerland':'ch',
        'denmark':'dk','sweden':'se','norway':'no','poland':'pl','czech republic':'cz',
        'croatia':'hr','serbia':'rs','romania':'ro','ukraine':'ua','russia':'ru',
        'usa':'us','united states':'us','mexico':'mx','colombia':'co','chile':'cl',
        'japan':'jp','south korea':'kr','australia':'au','china':'cn','india':'in',
        'saudi arabia':'sa','qatar':'qa','egypt':'eg','morocco':'ma','nigeria':'ng',
        'south africa':'za','uruguay':'uy','paraguay':'py','peru':'pe','ecuador':'ec',
        'bolivia':'bo','venezuela':'ve','costa rica':'cr','honduras':'hn','panama':'pa',
        'canada':'ca','ireland':'ie','wales':'gb-wls','finland':'fi','iceland':'is',
        'hungary':'hu','bulgaria':'bg','slovakia':'sk','slovenia':'si','bosnia':'ba',
        'bosnia and herzegovina':'ba','north macedonia':'mk','montenegro':'me','albania':'al',
        'kosovo':'xk','cyprus':'cy','luxembourg':'lu','malta':'mt','estonia':'ee',
        'latvia':'lv','lithuania':'lt','georgia':'ge','armenia':'am','azerbaijan':'az',
        'israel':'il','iran':'ir','iraq':'iq','tunisia':'tn','algeria':'dz',
        'cameroon':'cm','ghana':'gh','senegal':'sn','ivory coast':'ci','kenya':'ke',
        'indonesia':'id','thailand':'th','vietnam':'vn','malaysia':'my','philippines':'ph',
        'singapore':'sg','new zealand':'nz','jamaica':'jm','trinidad and tobago':'tt',
        'el salvador':'sv','guatemala':'gt','cuba':'cu','dominican republic':'do',
        'bahrain':'bh','oman':'om','kuwait':'kw','jordan':'jo','lebanon':'lb',
        'uzbekistan':'uz','kazakhstan':'kz','belarus':'by','moldova':'md',
        'northern ireland':'gb-nir','faroe islands':'fo','liechtenstein':'li',
        'andorra':'ad','san marino':'sm','gibraltar':'gi','monaco':'mc'
      };
      function getCountryCode(name){
        if(!name) return '';
        return countryCodeMap[name.toLowerCase()] || name.toLowerCase().substring(0,2);
      }
      function flagImg(countryName, code){
        if(!code) code = getCountryCode(countryName);
        return `<img class="flagicon" src="{{ ExternalCustomPath('media/images/flags/4x3/') }}${code}.svg" alt="${countryName}" style="height:14px;vertical-align:text-top;margin-right:6px;">`;
      }

      // Sort all events by data-ste ASC on page load
      function sortEventsByDate(){
        var container = $('#all-events-inner');
        var items = container.children('.league_line_items').get();
        items.sort(function(a, b){
          var steA = parseInt($(a).data('ste')) || 0;
          var steB = parseInt($(b).data('ste')) || 0;
          return steA - steB;
        });
        $.each(items, function(i, el){
          container.append(el);
        });
      }

      async function updateLiveCounter(){
        let data = await makeRequest({
          resource: '',
          data: JSON.stringify({
            opName: 'GetNrLive'
          })
        });

        if(data.resultCode === 0){
          $('.live-count').text(data.responseInfo)
        }
      }

      function applyFilters(){
        let favs = getFavorites();

        if(isLiveMode){
          $('#all-events .league_line_items').each(function(){
            var $el = $(this);
            var cid = $el.data('cid');
            var showByCountry = (countries_selected.length === 0) || (countries_selected.indexOf(cid) !== -1);

            if(!showByCountry){
              $el.hide();
              return;
            }

            // Favorites filter in live mode
            if(currentFilter === 'favorites'){
              var hasVisibleFav = false;
              $el.find('.league_line_items_event').each(function(){
                var eid = String($(this).data('event-id') || '');
                var altEid = String($(this).data('event-alt-id') || '');
                if((eid && favs.indexOf(eid) !== -1) || (altEid && favs.indexOf(altEid) !== -1)){
                  $(this).show();
                  hasVisibleFav = true;
                } else {
                  $(this).hide();
                }
              });
              if(hasVisibleFav){
                $el.show();
              } else {
                $el.hide();
              }
            } else {
              $el.find('.league_line_items_event').show();
              $el.show();
            }
          });
          return;
        }

        // Normal mode: apply type + country + favorites filters
        $('#all-events .league_line_items').each(function(){
          var $el = $(this);
          var type = $el.data('event-type');
          var cid = $el.data('cid');
          var isLiveInjected = $el.hasClass('live-fav-injected');

          // Type filter — live-injected blocks only show in favorites mode
          if(isLiveInjected && currentFilter !== 'favorites'){
            $el.hide();
            return;
          }

          var showByType = (currentFilter === 'all' || currentFilter === 'favorites') || (currentFilter === type);

          // Country filter
          var showByCountry = (countries_selected.length === 0) || (countries_selected.indexOf(cid) !== -1);

          if(!showByType || !showByCountry){
            $el.hide();
            return;
          }

          // Favorites filter: show only events that are favorited
          if(currentFilter === 'favorites'){
            var hasVisibleFav = false;
            $el.find('.league_line_items_event').each(function(){
                var eid = String($(this).data('event-id') || '');
                var altEid = String($(this).data('event-alt-id') || '');
                if((eid && favs.indexOf(eid) !== -1) || (altEid && favs.indexOf(altEid) !== -1)){
                $(this).show();
                hasVisibleFav = true;
              } else {
                $(this).hide();
              }
            });
            if(hasVisibleFav){
              $el.show();
            } else {
              $el.hide();
            }
          } else {
            // Show all events in the league block
            $el.find('.league_line_items_event').show();
            $el.show();
          }
        });
      }

      function updateFilterDot(){
        if(currentFilter !== 'all'){
          $('#filter-active-dot').addClass('visible');
        } else {
          $('#filter-active-dot').removeClass('visible');
        }
      }

      function toggleFilterDropdown(){
        filterDropdownOpen = !filterDropdownOpen;
        if(filterDropdownOpen){
          $('#filter-dropdown').addClass('open');
          $('#filter-toggle-btn').addClass('open');
        } else {
          $('#filter-dropdown').removeClass('open');
          $('#filter-toggle-btn').removeClass('open');
        }
      }

      function closeFilterDropdown(){
        filterDropdownOpen = false;
        $('#filter-dropdown').removeClass('open');
        $('#filter-toggle-btn').removeClass('open');
      }

      function updateCountriesSelected(){
        $(`.filter-by-country-btn.selected`).removeClass('selected');
        $('.tabs-homepage-filters').empty();
        if(countries_selected.length > 0){
          for (let item of countries_selected){
            let element = $(`.filter-by-country-btn[data-cid="${item}"]`);
            element.addClass('selected');
            let category_name = element.data('cn');
            let category_code = element.data('country-code') || getCountryCode(category_name);
            $('.tabs-homepage-filters').append(`<a href="#" class="active" data-cid="${item}"><img class="flagicon ct-${category_code}" src="{{ ExternalCustomPath('media/images/flags/4x3/') }}${category_code}.svg" alt="${category_name}"> ${category_name} <i class="fa fa-times" aria-hidden="true"></i></a> `);
          }
        }
        applyFilters();
      }

      async function loadLiveEvents(){
        try {
          let data = await makeRequest({
            resource: '',
            data: JSON.stringify({
              opName: 'GetLiveResults'
            })
          });

          if(data.resultCode !== 0) return;

          let results = data.responseInfo;
          let eventsInner = $('#all-events-inner');
          eventsInner.empty();

          // Group results by tournament
          let grouped = {};
          if(Array.isArray(results)){
            for(let r of results){
              let key = r.cgi || 'unknown';
              if(!grouped[key]){
                grouped[key] = {
                  events: [],
                  name: r.cgn || '',
                  country: r.cn || '',
                  country_id: r.ci || '',
                  sport_name: r.sn || ''
                };
              }
              grouped[key].events.push(r);
            }
          }

          // Update sidebar countries for live mode — with flags
          let countriesContainer = $('.list-left-bar-hp-countries');
          countriesContainer.empty();
          let uniqueCountries = {};

          if(Object.keys(grouped).length === 0){
            eventsInner.html('<div class="live-empty-state" style="text-align:center;padding:60px 20px;color:var(--ks-text-secondary);background:var(--third-bg-color);border:1px solid var(--ks-border);border-radius:var(--ks-radius);"><i class="fa fa-signal" style="font-size:48px;color:var(--ks-text-dim);margin-bottom:16px;display:block;"></i><p style="font-size:14px;margin:0;">{{ Translate("No live events at the moment") }}</p></div>');
            return;
          }

          let favs = getFavorites();

          for(let key in grouped){
            let league = grouped[key];
            let scoreParts, html = '';
            let cc = getCountryCode(league.country);

            // Add country to sidebar with flag
            if(!uniqueCountries[league.country_id]){
              uniqueCountries[league.country_id] = league.country;
              countriesContainer.append(`<li class="filter-by-country-btn" data-cid="${league.country_id}" data-country-code="${cc}" data-cn="${league.country}"><a href="#" data-type="tournament">${flagImg(league.country, cc)} ${league.country} <i class="fa fa-window-close-o" aria-hidden="true"></i></a></li>`);
            }

            html += `<div class="league_line_items" data-cid="${league.country_id}" data-event-type="live">`;
            html += `<div class="league_line_items_header">${flagImg(league.country, cc)} ${league.country.toUpperCase()}: ${league.name}</div>`;
            html += `<div class="league_line_items_events">`;

            for(let event of league.events){
              scoreParts = (event.esc || '0:0').split(':');
              let matchTime = event.ect || '';
              let primaryId = event._id || event.int_id || '';
              let secondaryId = event.int_id || event._id || '';
              let linkId = event.int_id || event._id || '';
              let isFav = (primaryId && favs.indexOf(String(primaryId)) !== -1) || (secondaryId && favs.indexOf(String(secondaryId)) !== -1);
              html += `<div class="league_line_items_event" data-event-id="${primaryId}" data-event-alt-id="${secondaryId}">`;
              html += `<div class="league_line_items_event_opt fav-star-btn ${isFav ? 'is-fav' : ''}" data-eid="${primaryId}" data-eid-alt="${secondaryId}"><i class="fa ${isFav ? 'fa-star' : 'fa-star-o'}" aria-hidden="true"></i></div>`;
              html += `<div class="league_line_items_event_time"><span class="live-lbl">${matchTime}'</span></div>`;
              html += `<div class="league_line_items_event_name"><a href="/{{ lang }}/event/${linkId}">${(event.en || '').replace(' - ', '<br />')}</a></div>`;
              html += `<div class="league_line_items_event_score">${scoreParts[0] || '0'}<br />${scoreParts[1] || '0'}</div>`;
              html += `<div class="league_line_items_event_btn"><a href="/{{ lang }}/event/${linkId}"><i class="fa fa-info-circle" aria-hidden="true"></i></a></div>`;
              html += `</div>`;
            }

            html += `</div></div>`;
            eventsInner.append(html);
          }

          applyFilters();

        } catch(e){
          console.error('Error loading live events:', e);
        }
      }

      function enterLiveMode(){
        isLiveMode = true;

        // Remove any injected live-fav blocks before saving original
        $('.live-fav-injected').remove();

        originalEventsHTML = $('#all-events-inner').html();
        originalCountriesHTML = $('.list-left-bar-hp-countries').html();

        $('#live-events-btn').addClass('tabs-homepage-live--active');
        // Hide results/next filters in live mode
        $('.filter-type-btn[data-filter="results"], .filter-type-btn[data-filter="next"]').hide();
        // Reset filter to 'all' when entering live
        currentFilter = 'all';
        $('.filter-type-btn').removeClass('active');
        $('.filter-type-btn[data-filter="all"]').addClass('active');
        updateFilterDot();
        countries_selected = [];
        updateCountriesSelected();

        loadLiveEvents();
        liveRefreshTimer = setInterval(loadLiveEvents, 15000);
      }

      function exitLiveMode(){
        isLiveMode = false;

        if(liveRefreshTimer){
          clearInterval(liveRefreshTimer);
          liveRefreshTimer = null;
        }

        // Save current live events HTML before restoring original
        lastLiveEventsHTML = $('#all-events-inner').html();

        if(originalEventsHTML !== null){
          $('#all-events-inner').html(originalEventsHTML);
        }
        if(originalCountriesHTML !== null){
          $('.list-left-bar-hp-countries').html(originalCountriesHTML);
        }

        // Append favorited live events to the DOM (hidden by default)
        appendFavoritedLiveEvents();

        $('#live-events-btn').removeClass('tabs-homepage-live--active');
        // Restore results/next filters
        $('.filter-type-btn[data-filter="results"], .filter-type-btn[data-filter="next"]').show();

        countries_selected = [];
        currentFilter = 'all';
        $('.filter-type-btn').removeClass('active');
        $('.filter-type-btn[data-filter="all"]').addClass('active');
        updateFilterDot();
        updateCountriesSelected();
        refreshFavStars();
        applyFilters();
      }

      // Extract favorited live events from saved HTML and append them (hidden) to the main list
      function appendFavoritedLiveEvents(){
        if(!lastLiveEventsHTML) return;
        let favs = getFavorites();
        if(favs.length === 0) return;

        let $temp = $('<div>').html(lastLiveEventsHTML);
        $temp.find('.league_line_items').each(function(){
          let $league = $(this).clone();
          $league.attr('data-event-type', 'live');
          let hasFavEvent = false;

          $league.find('.league_line_items_event').each(function(){
            let eid = String($(this).data('event-id') || '');
            let altEid = String($(this).data('event-alt-id') || '');
            let isFav = (eid && favs.indexOf(eid) !== -1) || (altEid && favs.indexOf(altEid) !== -1);
            if(!isFav){
              $(this).remove();
            } else {
              hasFavEvent = true;
            }
          });

          if(hasFavEvent){
            // Mark as live-sourced and hide by default (only shown in favorites filter)
            $league.addClass('live-fav-injected').hide();
            $('#all-events-inner').append($league);
          }
        });
      }

      $(document).ready(function(){

        // Sort events by date ASC on load
        sortEventsByDate();

        // Initialize favorites
        refreshFavStars();
        updateFavCount();

        updateLiveCounter();
        timerLiveCounter = setInterval(updateLiveCounter, 10000);

        // Live button toggle
        $(document).off('click', '#live-events-btn');
        $(document).on('click', '#live-events-btn', function(e){
          e.preventDefault();
          if(isLiveMode){
            exitLiveMode();
          }else{
            enterLiveMode();
          }
        });

        // Favorite star click
        $(document).off('click', '.fav-star-btn');
        $(document).on('click', '.fav-star-btn', function(e){
          e.preventDefault();
          e.stopPropagation();
          let eid = $(this).data('eid');
          let altEid = $(this).data('eid-alt');
          toggleFavorite(eid, altEid);
        });

        // Filter dropdown toggle
        $(document).off('click', '#filter-toggle-btn');
        $(document).on('click', '#filter-toggle-btn', function(e){
          e.preventDefault();
          e.stopPropagation();
          toggleFilterDropdown();
        });

        // Close dropdown on outside click
        $(document).on('click', function(e){
          if(!$(e.target).closest('.tabs-filter-icon-wrapper').length){
            closeFilterDropdown();
          }
        });

        // Type filter buttons
        $(document).off('click', '.filter-type-btn');
        $(document).on('click', '.filter-type-btn', function(e){
          e.preventDefault();
          $('.filter-type-btn').removeClass('active');
          $(this).addClass('active');
          currentFilter = $(this).data('filter');
          updateFilterDot();
          applyFilters();
          closeFilterDropdown();
        });

        // Country filter tag removal
        $(document).off('click', '.tabs-homepage-filters a');
        $(document).on('click', '.tabs-homepage-filters a', function(e){
          e.preventDefault();
          let cid   = $(this).data('cid');
          let newList = [];
          for(let item of countries_selected){
            if(cid !== item) newList.push(item);
          }
          countries_selected = newList;
          updateCountriesSelected();
        });

        // Country sidebar click
        $(document).off('click', '.filter-by-country-btn');
        $(document).on('click', '.filter-by-country-btn', function(e){
          e.preventDefault();
          let el    = $(this);
          let cid   = el.data('cid');
          if(countries_selected.indexOf(cid) === -1){
            countries_selected.push(cid);
          }else{
            let newList = [];
            for(let item of countries_selected){
              if(cid !== item) newList.push(item);
            }
            countries_selected = newList;
          }
          updateCountriesSelected();
        });
      });

    </script>

    <script>
      /* AdSense gap fix */
      (function collapseEmptyAds() {
        document.querySelectorAll('.ks-ad-wrapper').forEach(function(wrapper) {
          var ins = wrapper.querySelector('ins.adsbygoogle');
          if (!ins) { wrapper.classList.add('ks-ad-collapsed'); return; }

          function check() {
            var status = ins.getAttribute('data-ad-status');
            var hasIframe = ins.querySelector('iframe');
            var iframeH = hasIframe ? hasIframe.offsetHeight : 0;

            if (status === 'unfilled' || (!hasIframe && ins.children.length === 0) || iframeH < 10) {
              wrapper.classList.add('ks-ad-collapsed');
              ins.style.display = 'none';
              ins.style.height = '0';
            } else if (status === 'filled' && iframeH > 10) {
              wrapper.classList.remove('ks-ad-collapsed');
            }
          }

          var observer = new MutationObserver(check);
          observer.observe(ins, { attributes: true, childList: true, subtree: true });

          setTimeout(check, 500);
          setTimeout(check, 1500);
          setTimeout(check, 3000);
          setTimeout(check, 5000);
        });
      })();
    </script>

    <script>
      /* Custom scrollbar for #all-events */
      (function() {
        var inner = document.getElementById('all-events-inner');
        var track = document.getElementById('ks-scrollbar-track');
        var thumb = document.getElementById('ks-scrollbar-thumb');
        if (!inner || !track || !thumb) return;

        // Block wheel scroll on events — page scroll passes through
        inner.parentElement.addEventListener('wheel', function(e) {
          // Prevent internal scroll, let page scroll naturally
          e.preventDefault();
          // Forward the scroll to the page
          window.scrollBy(0, e.deltaY);
        }, { passive: false });

        function updateThumb() {
          var ratio = inner.clientHeight / inner.scrollHeight;
          if (ratio >= 1) {
            track.style.display = 'none';
            return;
          }
          track.style.display = 'block';
          var thumbH = Math.max(50, ratio * track.clientHeight);
          thumb.style.height = thumbH + 'px';
          var scrollRatio = inner.scrollTop / (inner.scrollHeight - inner.clientHeight);
          thumb.style.top = (scrollRatio * (track.clientHeight - thumbH)) + 'px';
        }

        inner.addEventListener('scroll', updateThumb);
        window.addEventListener('resize', updateThumb);
        setTimeout(updateThumb, 200);
        setTimeout(updateThumb, 1000);

        // Drag thumb
        var dragging = false, startY = 0, startTop = 0;
        thumb.addEventListener('mousedown', function(e) {
          e.preventDefault();
          dragging = true;
          startY = e.clientY;
          startTop = parseInt(thumb.style.top) || 0;
          thumb.classList.add('dragging');
          document.body.style.userSelect = 'none';
        });
        document.addEventListener('mousemove', function(e) {
          if (!dragging) return;
          var dy = e.clientY - startY;
          var ratio = inner.clientHeight / inner.scrollHeight;
          var thumbH = Math.max(50, ratio * track.clientHeight);
          var maxTop = track.clientHeight - thumbH;
          var newTop = Math.min(Math.max(0, startTop + dy), maxTop);
          thumb.style.top = newTop + 'px';
          inner.scrollTop = (newTop / maxTop) * (inner.scrollHeight - inner.clientHeight);
        });
        document.addEventListener('mouseup', function() {
          if (dragging) {
            dragging = false;
            thumb.classList.remove('dragging');
            document.body.style.userSelect = '';
          }
        });

        // Click on track to jump
        track.addEventListener('click', function(e) {
          if (e.target === thumb) return;
          var rect = track.getBoundingClientRect();
          var clickY = e.clientY - rect.top;
          var ratio = inner.clientHeight / inner.scrollHeight;
          var thumbH = Math.max(50, ratio * track.clientHeight);
          var maxTop = track.clientHeight - thumbH;
          var newTop = Math.min(Math.max(0, clickY - thumbH / 2), maxTop);
          thumb.style.top = newTop + 'px';
          inner.scrollTop = (newTop / maxTop) * (inner.scrollHeight - inner.clientHeight);
        });

        // Touch support
        thumb.addEventListener('touchstart', function(e) {
          e.preventDefault();
          dragging = true;
          startY = e.touches[0].clientY;
          startTop = parseInt(thumb.style.top) || 0;
          thumb.classList.add('dragging');
        }, { passive: false });
        document.addEventListener('touchmove', function(e) {
          if (!dragging) return;
          var dy = e.touches[0].clientY - startY;
          var ratio = inner.clientHeight / inner.scrollHeight;
          var thumbH = Math.max(50, ratio * track.clientHeight);
          var maxTop = track.clientHeight - thumbH;
          var newTop = Math.min(Math.max(0, startTop + dy), maxTop);
          thumb.style.top = newTop + 'px';
          inner.scrollTop = (newTop / maxTop) * (inner.scrollHeight - inner.clientHeight);
        }, { passive: false });
        document.addEventListener('touchend', function() {
          if (dragging) {
            dragging = false;
            thumb.classList.remove('dragging');
          }
        });
      })();
    </script>

