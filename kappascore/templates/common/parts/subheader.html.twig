<style>
    html, body {
        width: 100%;
        max-width: 100vw;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        position: relative;
        box-sizing: border-box;
    }

    *, *:before, *:after {
        box-sizing: inherit;
    }

    .subheader-sports {
        background: #0a0a0a;
        padding: 0;
        overflow: hidden;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        position: sticky;
        top: 50px;
        z-index: 80;
        width: 100%;
        box-sizing: border-box;
    }

    .subheader-sports .main-container {
        position: relative;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        overflow: hidden;
        box-sizing: border-box;
    }

    .subheader-sports-content {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        padding: 10px 0;
        scrollbar-width: none;
        -ms-overflow-style: none;
        -webkit-overflow-scrolling: touch;
        width: 100%;
        justify-content: center;
        flex-wrap: nowrap;
    }

    .subheader-sports-content::-webkit-scrollbar {
        display: none;
    }

    .subheader-sport-item {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 999px;
        background: transparent;
        transition: all 0.2s ease;
    }

    .subheader-sport-item.selected {
        background: #22c55e;
        color: #000;
        border-color: transparent;
        font-weight: 700;
        box-shadow: 0 2px 12px rgba(34, 197, 94, 0.35);
    }

    .subheader-sport-item a {
        color: inherit;
        text-transform: uppercase;
        font-size: 11.5px;
        text-decoration: none;
        font-weight: 600;
        padding: 7px 14px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

    .subheader-sport-item svg {
        height: 14px;
        width: 14px;
        fill: currentColor;
        flex-shrink: 0;
    }

    .subheader-sports .right-hover {
        background: linear-gradient(to left, #0a0a0a 0%, transparent 100%);
        position: absolute;
        top: 0;
        bottom: 0;
        right: 0;
        width: 40px;
        pointer-events: none;
        z-index: 2;
    }

    /* Platform bar - mobile only */
    .ks-platform-bar {
        display: none;
        background: #0a0a0a;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        padding: 8px 0;
        width: 100%;
        box-sizing: border-box;
    }
    .ks-platform-bar .main-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        flex-wrap: wrap;
        padding: 0 12px;
        box-sizing: border-box;
    }
    .ks-platform-bar a {
        display: inline-flex;
        align-items: center;
        font-size: 11px;
        text-transform: uppercase;
        text-decoration: none;
        color: #888;
        font-weight: 700;
        letter-spacing: 0.8px;
        padding: 6px 16px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: all 0.2s ease;
        white-space: nowrap;
        max-width: calc(33% - 8px);
        overflow: hidden;
        text-overflow: ellipsis;
        box-sizing: border-box;
    }
    .ks-platform-bar a:hover {
        color: #fff;
        border-color: rgba(255, 255, 255, 0.15);
    }
    .ks-platform-bar a.active {
        color: #000;
        background: #22c55e;
        border-color: transparent;
        font-weight: 700;
        box-shadow: 0 2px 10px rgba(34, 197, 94, 0.3);
    }

    /* Mobile */
    @media only screen and (max-width: 768px) {
        .subheader-sports {
            top: 50px;
        }
        .subheader-sports .main-container {
            padding: 0 12px;
            max-width: 100%;
        }
        .subheader-sports-content {
            justify-content: flex-start;
            gap: 6px;
            padding: 8px 0;
        }
        .subheader-sport-item a {
            font-size: 10.5px !important;
            padding: 6px 12px !important;
            gap: 5px !important;
        }
        .subheader-sport-item svg {
            height: 12px !important;
            width: 12px !important;
        }
        .ks-platform-bar {
            display: block;
        }
        .ks-platform-bar a {
            font-size: 10px;
            padding: 5px 12px;
            letter-spacing: 0.5px;
        }
    }

    /* Small mobile */
    @media only screen and (max-width: 480px) {
        .subheader-sports .main-container {
            padding: 0 8px;
        }
        .subheader-sport-item a {
            font-size: 9.5px !important;
            padding: 5px 10px !important;
            gap: 4px !important;
        }
        .subheader-sport-item svg {
            height: 11px !important;
            width: 11px !important;
        }
        .ks-platform-bar a {
            font-size: 9px;
            padding: 4px 10px;
            letter-spacing: 0.3px;
            max-width: calc(33% - 6px);
        }
    }

    /* Ultra small */
    @media only screen and (max-width: 320px) {
        .subheader-sport-item a {
            font-size: 8.5px !important;
            padding: 4px 8px !important;
            gap: 3px !important;
        }
        .ks-platform-bar a {
            font-size: 8px;
            padding: 3px 8px;
        }
    }
</style>

<div class="subheader-sports">
    <div class="main-container">
        <div class="subheader-sports-content">
            {# Soccer always first #}
            <div class="subheader-sport-item {% if sport_selected is defined and sports|length > 0 and sports[0] is defined and sport_selected == sports[0]._id %}selected{% endif %} {% for sport in sports %}{% if sport.oxb_id == 1 and sport_selected == sport._id %}selected{% endif %}{% endfor %}" data-sid="1">
                <a href="{{ parent_page }}/soccer">
                    <svg class="icon"><use xlink:href="/images/sport_icons.svg#sports_1"></use></svg>
                    {{ Translate('Soccer') }}
                </a>
            </div>
            {% for sport in sports %}
                {% if sport.oxb_id != 1 %}
                <div class="subheader-sport-item {% if sport_selected == sport._id %}selected{% endif %}" data-sid="{{ sport.oxb_id }}">
                    <a href="{{ parent_page }}/{{ sport.sport_key }}">
                        <svg class="icon"><use xlink:href="/images/sport_icons.svg#sports_{{ sport.oxb_id }}"></use></svg>
                        {{ Translate(sport.name) }}
                    </a>
                </div>
                {% endif %}
            {% endfor %}
        </div>
        <div class="right-hover"></div>
    </div>
</div>


<div class="ks-platform-bar">
    <div class="main-container">
        <a class="active" href="https://kappascore.com">{{ Translate('Sports') }}</a>
        <a href="https://kappaslot.com">{{ Translate('Games') }}</a>
        <a href="https://kappatop.com">{{ Translate('Top Lists') }}</a>
    </div>
</div>